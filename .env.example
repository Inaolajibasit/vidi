NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
TMDB_API_KEY=your-tmdb-api-key
TMDB_ACCESS_TOKEN=your-tmdb-access-token
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LEGAL_EMAIL=your-monitored-contact@example.com

# Shelved until the challenge flow is ready for production.
ENABLE_CHALLENGES=false

# First-party, server-side product analytics. Generate a random secret with at
# least 32 characters and never expose it through a NEXT_PUBLIC_ variable.
ANALYTICS_PROVIDER=disabled
ANALYTICS_HASH_SECRET=replace-with-a-long-random-secret

# Optional movie sync configuration
MOVIE_SYNC_TARGET=4000

# When true, a right swipe without a chosen reaction records "Liked".
# When false, the card waits for the player to choose a reaction.
ENABLE_DEFAULT_LIKE_ON_SWIPE=false
