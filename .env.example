# Public connection values. The publishable key is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Server-only Supabase secret. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Configure at least one. The API Read Access Token is preferred.
TMDB_ACCESS_TOKEN=your-tmdb-api-read-access-token
# TMDB_API_KEY=your-tmdb-v3-api-key

# Exact application origin, including the scheme and without a path.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LEGAL_EMAIL=your-monitored-contact@example.com

# Shelved until the challenge flow is ready for production.
ENABLE_CHALLENGES=false

# First-party, server-side product analytics. Generate a random secret with at
# least 32 characters and never expose it through a NEXT_PUBLIC_ variable.
ANALYTICS_PROVIDER=disabled
ANALYTICS_HASH_SECRET=replace-with-a-long-random-secret

# Optional movie sync configuration. Production supports 3,000-5,000 movies.
MOVIE_SYNC_TARGET=4000

# When true, a right swipe without a chosen reaction records "Liked".
# When false, the card waits for the player to choose a reaction.
ENABLE_DEFAULT_LIKE_ON_SWIPE=false
